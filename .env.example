# ── Server ────────────────────────────────────────────────────
PORT=4020
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=

# ── Remote Postgres ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@your-pg-host:5432/codereview

# ── Remote Redis (BullMQ + sessions) ────────────────────────
REDIS_URL=redis://your-redis-host:6379

# ── GitHub OAuth ─────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4020/api/auth/github/callback

# ── GitHub Webhooks ──────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=http://localhost:4020

# ── AI / LLM ────────────────────────────────────────────────
NVIDIA_KEY=

# ── Security ─────────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=

# ── SMTP (leave empty to use Ethereal test emails in dev) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Code Review AI" <noreply@codereview.ai>
